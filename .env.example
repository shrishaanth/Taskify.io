# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB — use localhost for dev, Atlas for production
DATABASE_URL=mongodb://localhost:27017/taskify

# JWT — generate a strong random secret for production
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional) — enables multi-instance sockets, caching, presence, locks
REDIS_URL=

# MinIO / S3 — file storage for attachments
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=taskify
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# CORS — comma-separated extra origins for deployed clients
CLIENT_ORIGINS=http://localhost:5173

# Instance label — surfaced by /api/health (set per replica)
INSTANCE_ID=

# ── Client (prefix with VITE_) ─────────────────────────────────
VITE_API_URL=/api
VITE_SOCKET_URL=

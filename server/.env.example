# Copy to server/.env and fill in. `.env` is gitignored.

NODE_ENV=development
PORT=4000

# MongoDB connection string (Atlas or local).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/taskify?retryWrites=true&w=majority

# JWT secrets — use long random strings in real environments.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Token lifetimes.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS origin for the client dev server.
CLIENT_ORIGIN=http://localhost:5173
